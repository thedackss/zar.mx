---
import styles from "./index.module.scss";

const name = "zar.mx";

const links = [
    { label: "zar.software", href: "https://zar.software" },
    // { label: "taf16.com", href: "https://taf16.com" },
    { label: "github", href: "https://github.com/thedackss" },
    { label: "email", href: "mailto:diego@zar.mx" },
    { label: "whatsapp", href: "https://wa.me/529171040172" },
    { label: "x", href: "https://x.com/thedackss" },
    { label: "instagram", href: "https://instagram.com/thedackss" },
    { label: "discord", href: "https://discord.com/users/524970765095796777" },
];
---

<main class={styles.landing}>
    <header>
        <h1>{name}</h1>
        <p data-breaking="breaking things" data-building="building things">
            <span>building things</span><span data-caret aria-hidden="true"></span>
        </p>
    </header>

    <nav>
        {
            links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                    <span class={styles.label}>{link.label}</span>
                    <span class={styles.icon}>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-3.5 w-3.5"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            width="16"
                            height="16"
                        >
                            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />{" "}
                            <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />{" "}
                        </svg>
                    </span>
                </a>
            ))
        }
    </nav>
</main>

<script>
    // Tagline gag: type "breaking things", erase it, settle on "building things"
    const bio = document.querySelector<HTMLElement>("[data-building]");
    if (bio && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const words = bio.firstElementChild as HTMLElement;
        const caret = bio.lastElementChild as HTMLElement;
        const sleep = (ms: number) => new Promise((done) => setTimeout(done, ms));

        const type = async (text: string) => {
            for (const char of text) {
                words.textContent += char;
                await sleep(55);
            }
        };

        const erase = async () => {
            while (words.textContent) {
                words.textContent = words.textContent.slice(0, -1);
                await sleep(35);
            }
        };

        (async () => {
            words.textContent = "";
            caret.dataset.on = "";
            await sleep(700);
            await type(bio.dataset.breaking ?? "");
            await sleep(1300);
            await erase();
            await sleep(300);
            await type(bio.dataset.building ?? "");
            await sleep(1500);
            delete caret.dataset.on;
        })();
    }
</script>
