---
import Layout from "@/layouts/base.astro";
import Glow from "@/components/glow/index.astro";
import Landing from "@/components/landing/index.astro";
import Inspiration from "@/components/inpiration/index.astro";
---

<Layout
    lang="en"
    description="zar.mx — Diego Zamora's personal hub: projects, services, and everywhere to find him. Breaking things, building things."
    path="/"
    ogImage="/og.png"
>
    <Landing lang="en" />
    <Inspiration />
    <Glow />
</Layout>

<script>
    // Spanish browsers land on /es unless they've explicitly chosen a language
    if (
        !localStorage.getItem("lang") &&
        navigator.language?.toLowerCase().startsWith("es")
    ) {
        location.replace("/es");
    }
</script>
