---
// Internal render target for the social image (1200x630). Regenerate with the
// dev server running: screenshot /og → public/og.png with playwright at
// exactly 1200x630.
import "./og.scss";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex" />
        <title>og</title>
    </head>
    <body>
        <main class="card">
            <div class="grid" aria-hidden="true"></div>
            <img src="/icon.svg" alt="" />
            <h1>zar<span>.mx</span></h1>
            <p class="tagline">building things</p>
        </main>
    </body>
</html>
